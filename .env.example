# Copy to .env and fill in. Never commit .env.

# --- Exa web search (hunter_agent, dashboard, furniture-agent) ---
EXA_API_KEY=

# --- Hunter Agent Supabase project (hunter_agent, dashboard) ---
HUNTER_SUPABASE_URL=
HUNTER_SUPABASE_KEY=

# --- Invoice Supabase project (dashboard, invoice_system) ---
INVOICE_SUPABASE_URL=
INVOICE_SUPABASE_KEY=

# --- Furniture agent Supabase (furniture-agent) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never ship this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram bot (telegram_app.py, furniture-agent/bot.py) ---
TELEGRAM_BOT_TOKEN=

# --- Language models ---
PERPLEXITY_API_KEY=
LOCAL_BASE_URL=
LOCAL_MODEL_ID=

# --- Invoice system: email and seller details ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SELLER_NAME=
SELLER_ADDRESS=
SELLER_GSTIN=
CONTACT_PERSON=
CONTACT_EMAIL=
CONTACT_MOBILE=
BANK_NAME=
BANK_BENEFICIARY=
BANK_ACCOUNT=
BANK_IFSC=

# --- Development ---
# Set to 1 to enable the Flask debugger. Never enable it on a reachable host.
FLASK_DEBUG=0
