# Dashboard (dashboard/app.py) configuration
# Copy to .env for local runs, or set these as Vercel project environment variables.

# Flask session signing key - use a long random string in production
FLASK_SECRET_KEY=change-me

# Exa.ai search key - https://exa.ai
EXA_API_KEY=

# Supabase project holding the `leads` table (Hunter Agent)
HUNTER_SUPABASE_URL=
HUNTER_SUPABASE_KEY=

# Supabase project holding the `invoices` table (Invoice System)
INVOICE_SUPABASE_URL=
INVOICE_SUPABASE_KEY=
